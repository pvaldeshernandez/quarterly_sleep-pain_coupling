# Python
__pycache__/
*.pyc
*.pyo
.pytensor_cache/
*.egg-info/

# MATLAB
*.asv

# Data (real data never committed)
data/real/

# Sandbox: commit the audit markdown files at the top level, but
# never commit the fitted model outputs under subdirectories
# (posterior draws, processed participant data, logs).
sandbox/*/
!sandbox/*.md

# Large neuroimaging files
*.nii
*.nii.gz
*.mat
# Exception: atlas NIfTIs in rois/atlases/
!matlab/rois/atlases/*.nii.gz

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Jupyter
.ipynb_checkpoints/
